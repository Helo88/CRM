# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:4000

# Database
MONGODB_URI=mongodb://localhost:27017/azmsquad_customer_service

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=15m

# Refresh tokens (backend-only HMAC key for the deterministic rotation chain
# — see .squad/plans/auth/02-story-login-customer-agent-or-admin.md). Never
# reused for anything else, never sent to the client.
REFRESH_CHAIN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_TTL=30d

# AI agent (Google Gemini free tier)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Outbound email (ticket acknowledgments + agent replies)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="AzmSquad Support <support@example.com>"
