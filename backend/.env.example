# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/azmsquad_customer_service

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# AI agent (Google Gemini free tier)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Outbound email (ticket acknowledgments + agent replies)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="AzmSquad Support <support@example.com>"
